cat > .gitignore <<'EOF'
# ==========================
# Python
# ==========================

__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# ==========================
# Environments
# ==========================

.venv/
venv/
env/
conda-meta/

.env
.env.*
!.env.example

# ==========================
# IDE
# ==========================

.vscode/
.idea/

# ==========================
# macOS
# ==========================

.DS_Store

# ==========================
# Logs
# ==========================

*.log
failed_markers.txt
completed_markers.txt

# ==========================
# BLAST / DNABarcoder temporary files
# ==========================

*.nhr
*.nin
*.nsq
*.ndb
*.njs
*.not
*.ntf
*.nto

*.phr
*.pin
*.pog
*.pot
*.psq
*.ptf
*.pto
*.pdb

# Large similarity matrices
*.sim

# ==========================
# Raw / generated input datasets
# ==========================

input/

# Accidental nested DNABarcoder output directory
/dnabarcoder/

# ==========================
# DNABarcoder generated prediction output
# ==========================

output/*
!output/.gitkeep

# ==========================
# Results
#
# Ignore generated results by default,
# but retain publication-ready summaries,
# figures, and lightweight marker summaries.
# ==========================

results/*

# Keep folder marker
!results/.gitkeep

# Final cross-marker summaries
!results/final_summary/
!results/final_summary/**

# Publication figures + their source CSVs
!results/figures/
!results/figures/**

# Keep individual marker result directories
!results/*_focus/

# Ignore everything inside them by default
results/*_focus/*

# Keep lightweight characterization outputs
!results/*_focus/*_sequence_length_summary.csv
!results/*_focus/*_sequence_length_distribution.png
!results/*_focus/*_indistinguishable_summary.csv
!results/*_focus/*_indistinguishable_species_groups.csv
!results/*_focus/*_indistinguishable_groups_by_genus.csv

# ==========================
# Temporary files
# ==========================

*.tmp
*.temp
*.bak
EOF